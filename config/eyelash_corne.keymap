#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#define L_BASE         0
#define L_SYMNUM       1
#define L_NAV          2
#define L_FUNC         3
#define L_MOUSE        4 
#define L_STUFF        5 
#define L_TEST         6
#define L_COLEMAK      7

// TODO: convert left ctrl and alt to right versions, where appropriate
// TODO maybe move the numbers to bottom row?
// idea: add 'one handed mode' layers. e.g. for arrow keys.

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };
&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};
&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };
    behaviors {
         // test tap dance. prints 1 or 2 or 3
         td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };
         // bt selection tap dance. the point is to only trigger if really intentional. 1 press prints a dot or something. only triple click works
         // note: i call it 1 but internally it is zero based
         td_bt1: td_bt1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DOT>, <&kp DOT>, <&bt BT_SEL 0>;
        };
    };




    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };


        combo_asdl_to_stuff {
            timeout-ms = <50>;
            key-positions = <14 15 16 25>;
            bindings = <&to L_STUFF>;
        };


        combo_wer_capsword {
            timeout-ms = <50>;
            key-positions = <2 3 4>;
            bindings = <&caps_word>;
        };


        combo_cvb_bootloader {
            timeout-ms = <50>;
            key-positions = <31 32 33>;
            bindings = <&bootloader>;
        };


        combo_yui_to_home {
            timeout-ms = <50>;
            key-positions = <7 8 9>;
            bindings = <&to L_BASE>;
        };


        combo_iop_to_mouse {
            timeout-ms = <50>;
            key-positions = <9 10 11>;
            bindings = <&to L_MOUSE>;
        };


        combo_sticky_alt_a {
            timeout-ms = <50>;
            key-positions = <14 26>;
            bindings = <&sk LALT>;
        };


        combo_sticky_shift_s {
            timeout-ms = <50>;
            key-positions = <15 25>;
            bindings = <&sk LSHIFT>;
        };


        combo_sticky_ctrl_c {
            timeout-ms = <50>;
            key-positions = <31 38>;
            bindings = <&sk LCTRL>;
        };


        combo_sticky_shift {
            timeout-ms = <50>;
            key-positions = <28 41>;
            bindings = <&sk LSHIFT>;
        };


        combo_sticky_sym_y {
            timeout-ms = <50>;
            key-positions = <5 7>;
            bindings = <&sl L_SYMNUM>;
        };


        combo_sticky_func_u {
            timeout-ms = <50>;
            key-positions = <4 8>;
            bindings = <&sl L_FUNC>;
        };

    };


    // but just &kp LC(C) is simpler than macro_copy..
    macros {
        macro1: macro1 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = 
            <&kp H>,
            <&kp E>,
            <&kp L>,
            <&kp L>,
            <&kp O>,
            <&kp SPACE>,
            <&kp T>,
            <&kp H>,
            <&kp E>,
            <&kp R>,
            <&kp E>,
            <&kp EXCL>,
            <&kp SPACE>;
        };
        macro2: macro2 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = 
            <&kp X>,
            <&kp SPACE>;
        };
        macro3: macro3 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <30>;
        tap-ms = <30>;
                    mymacro0: mymacro0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp E &kp C &kp H &kp O &kp SPACE &kp APOS &kp RET &kp RET &kp RET &kp RET &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &mymacro1>;
        };
        mymacro1: mymacro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp RET &kp RET &kp W &kp E &kp R &kp EQUAL &kp C &kp A &kp P &kp S &kp W &kp RET &kp Y &kp U &kp I &mymacro2>;
        };
        mymacro2: mymacro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp EQUAL &kp L &kp UNDER &kp B &kp A &kp S &kp E &kp RET &kp I &kp O &kp P &kp EQUAL &kp L &kp UNDER &kp M &kp O &kp U &kp S &kp E &kp RET &mymacro3>;
        };
        mymacro3: mymacro3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp RET &kp C &kp V &kp B &kp EQUAL &kp B &kp O &kp O &kp T &kp RET &kp A &kp S &kp D &kp L &kp EQUAL &kp M &kp A &kp C &kp R &kp O &mymacro4>;
        };
        mymacro4: mymacro4 {
            compatible = "zmk,behavior-macro";
