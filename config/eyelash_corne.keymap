    keymap {
        compatible = "zmk,keymap";


// GLOSSARY FOR KEY POSITIONS
//=================================================================================================================================================================================================================
//
// 1       q(2)               w(3)             e(4)         r(5)               t(6)                ()                       y(8)                u(9)            i(10)            o(11)        p(12)           13
// 14      a(15)              s(16)            d(17)        f(18)              g(19)             ()()()                     h(23)               j(24)           k(25)            l(26)        27              28
// 29      z(30)              x(31)            c(32)        v(33)              b(34)             ()()                       n(37)                m(38)          39               40           41              42
//                                                                                                 (6)
//                                                                              43 44 45                        46 47 48
//=================================================================================================================================================================================================================




    // Layer Base
    ///////////////////////////////////
    layer0 {
    bindings = <

            &kp ESC &kp Q &kp W &kp E &kp R &kp T        &none        &kp Y &kp U &kp I &kp O &kp P &kp DEL
            &mt LCTRL TAB &kp A &kp S &kp D &mt LSHIFT F &kp G  &none &none &none  &kp H &mt RSHIFT J &kp K &kp L &kp SEMI &mt RCTRL APOS
            &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B  &none &none        &kp N &kp M &kp COMMA &kp DOT &mt RGUI FSLH &kp RSHIFT
            &mt LALT ESC &lt L_SYMNUM SPACE &lt L_NAV TAB                     &lt L_NAV ENTER &lt L_SYMNUM SPACE &mt RALT BACKSPACE

            >; display-name = "Base"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer SymNum
    ///////////////////////////////////
    layer1 {
    bindings = <

            &kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT        &none        &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp PIPE
            &kp MINUS &kp N1 &kp N2 &kp N3 &kp N4 &kp N5  &none &none &none  &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp PLUS
            &kp UNDERSCORE &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp PLUS  &none &none        &kp BSLH &kp EQUAL &trans &trans &trans &kp GRAVE
            &kp UNDERSCORE &trans &kp MINUS                     &kp ENTER &trans &trans

            >; display-name = "SymNum"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Nav
    ///////////////////////////////////
    layer2 {
    bindings = <

            &bootloader &none &none &none &none &none        &none        &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &none
            &none &none &kp LALT &kp LCTRL &kp LSHIFT &none  &none &none &none  &kp LEFT &kp DOWN &kp UP &kp RIGHT &caps_word &none
            &none &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &kp K_REDO  &none &none        &kp HOME &kp PG_DN &kp PG_UP &kp END &kp INS &none
            &trans &trans &trans                     &kp ENTER &kp ENTER &kp BSPC

            >; display-name = "Nav"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Func
    ///////////////////////////////////
    layer3 {
    bindings = <

            &bootloader &kp F1 &kp F2 &kp F3 &kp F4 &kp F5        &none        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
            &none &kp F11 &kp F12 &none &kp SLCK &kp PSCRN  &none &none &none  &none &none &none &none &none &none
            &out OUT_BLE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp PAUSE_BREAK  &none &none        &none &none &none &none &none &out OUT_USB
            &td_bt1 &trans &trans                     &trans &trans &trans

            >; display-name = "Func"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Mouse
    ///////////////////////////////////
    layer4 {
    bindings = <

            &none &none &kp C_PREV &kp C_PP &kp C_NEXT &none        &none        &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &none
            &none &kp C_BRI_DN &kp C_BRI_UP &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE  &none &none &none  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
            &none &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &kp K_REDO  &none &none        &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none &none
            &trans &trans &trans                     &kp ENTER &mkp RCLK &mkp LCLK

            >; display-name = "Mouse"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Stuff
    ///////////////////////////////////
    layer5 {
    bindings = <

            &kp ESC &kp Q &kp W &kp E &kp R &kp T        &none        &to L_COLEMAK &to L_TEST &to L_MOUSE &to L_FUNC &to L_STUFF &kp DEL
            &caps_word &kp A &to L_FUNC &mt LCTRL D &mt LSHIFT F &kp G  &none &none &none  &kp X &mt LSHIFT J &mt LCTRL K &mt LALT L &kp SEMI &kp APOS
            &kp LSHIFT &macro1 &macro2 &mymacro0 &macro4 &kp B  &none &none        &kp N &to L_MOUSE &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
            &kp LGUI &trans &lt L_MOUSE ESC                     &lt L_NAV ENTER &lt L_SYMNUM SPACE &lt L_FUNC BACKSPACE

            >; display-name = "Stuff"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Test
    ///////////////////////////////////
    layer6 {
    bindings = <

            &kp ESC &kp Q &kp W &kp E &kp R &kp T        &none        &kp Y &kp U &kp I &kp O &kp P &kp DEL
            &mt LCTRL TAB &kp A &kp S &kp D &mt LSHIFT F &kp G  &none &none &none  &kp H &mt LSHIFT J &kp K &kp L &kp SEMI &mt RCTRL APOS
            &kp LCTRL &kp Z &kp X &kp C &kp V &kp B  &none &none        &kp N &kp M &mt RGUI COMMA &kp DOT &kp FSLH &kp RCTRL
            &mt LALT ESC &lt L_SYMNUM SPACE &lt L_NAV TAB                     &lt L_NAV ENTER &lt L_SYMNUM SPACE &mt RALT BACKSPACE

            >; display-name = "Test"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    // Layer Colemak
    ///////////////////////////////////
    layer7 {
    bindings = <

            &trans &kp Q &kp W &kp F &kp P &kp B        &none        &kp J &kp L &kp U &kp Y &kp SEMI &trans
            &trans &kp A &mt LALT R &mt LCTRL S &mt LSHIFT T &kp G  &none &none &none  &kp M &mt LSHIFT N &mt LCTRL E &mt LALT I &kp O &kp APOS
            &trans &kp Z &kp X &kp C &kp D &kp V  &none &none        &kp K &kp H &kp COMMA &kp DOT &kp FSLH &trans
            &kp LGUI &trans &trans                     &trans &trans &trans

            >; display-name = "Colemak"; sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; };



    };
};
